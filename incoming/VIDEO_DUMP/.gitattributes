# Папка намеренно выведена из-под Git LFS.
# В корне *.mp4 уходят в LFS, а хост lfs.github.com закрыт политикой исходящего
# трафика удалённой сессии: файлы в LFS приехали бы указателями, а не видео,
# и смонтировать их было бы нечем. Политика не обходится — обходится маршрут.
*.mp4 -filter -diff -merge -text
*.mov -filter -diff -merge -text
*.webm -filter -diff -merge -text
