# Скопировать в .env и заполнить. .env в репозиторий не коммитится никогда.
# Проверка: git check-ignore -v .env

# ─── Генерация изображений и видео ───────────────────────────────
# Higgsfield подключён через MCP — ключ в .env не нужен.
GEMINI_API_KEY=
XAI_API_KEY=

# ─── Seedance / Volcengine Ark ───────────────────────────────────
# Статус: NOT_CONNECTED. См. integrations/seedance/README.md
ARK_API_KEY=
ARK_REGION=

# ─── Озвучка ─────────────────────────────────────────────────────
ELEVENLABS_API_KEY=
# Voice ID фиксируются на CHECKPOINT 5 и не меняются до конца сезона
ELEVENLABS_VOICE_PROHOR=
ELEVENLABS_VOICE_SERAFIMA=
ELEVENLABS_VOICE_ADELAIDA=
ELEVENLABS_VOICE_LUKERYA=
ELEVENLABS_VOICE_HOUSE=

# ─── Research и публикация ───────────────────────────────────────
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# ─── Пути ────────────────────────────────────────────────────────
OUTPUT_DIR=output
